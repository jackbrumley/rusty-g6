{
  "name": "rusty-g6",
  "version": "0.2.0",
  "tasks": {
    "dev": "deno run -A scripts/dev.ts",
    "build": "deno run -A scripts/build.ts",
    "tauri": "deno run -A npm:@tauri-apps/cli",
    "check": "deno check src/**/*.ts src/**/*.tsx",
    "dev:ui": "vite",
    "build:ui": "deno task check && vite build",
    "preview": "vite preview"
  },
  "imports": {
    "preact": "npm:preact@^10.25.1",
    "preact/": "npm:preact@^10.25.1/",
    "preact/hooks": "npm:preact@^10.25.1/hooks",
    "preact/jsx-runtime": "npm:preact@^10.25.1/jsx-runtime",
    "@preact/preset-vite": "npm:@preact/preset-vite@^2.9.3",
    "@tauri-apps/api": "npm:@tauri-apps/api@^2",
    "@tauri-apps/plugin-opener": "npm:@tauri-apps/plugin-opener@^2",
    "vite": "npm:vite@^6.0.3"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "nodeModulesDir": "auto"
}
