{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rusty-g6",
  "version": "1.0.11",
  "identifier": "info.brumley.rustyg6",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rusty G6",
        "width": 620,
        "height": 540,
        "minWidth": 520,
        "minHeight": 440,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "postInstallScript": "scripts/deb/postinst.sh",
        "postRemoveScript": "scripts/deb/postrm.sh",
        "desktopTemplate": "packaging/bundler-stub.desktop.hbs",
        "files": {
          "/usr/share/applications/info.brumley.rustyg6.desktop": "packaging/info.brumley.rustyg6.desktop"
        }
      },
      "rpm": {
        "postInstallScript": "scripts/rpm/postinst.sh",
        "postRemoveScript": "scripts/rpm/postrm.sh",
        "desktopTemplate": "packaging/bundler-stub.desktop.hbs",
        "files": {
          "/usr/share/applications/info.brumley.rustyg6.desktop": "packaging/info.brumley.rustyg6.desktop"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/applications/rusty-g6.desktop": "packaging/info.brumley.rustyg6.desktop"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
